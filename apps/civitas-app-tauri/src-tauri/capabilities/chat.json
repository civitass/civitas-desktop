{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "consumer-chat",
  "description": "Chat history, explicit attachments, and explicit export permissions for the standalone chat window.",
  "local": true,
  "windows": ["chat"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:app:allow-version",
    "core:window:allow-theme",
    "core:window:allow-is-fullscreen",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:path:allow-resolve-directory",
    "core:path:allow-join",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "deep-link:allow-get-current",
    "os:allow-platform",
    "os:allow-os-type",
    "os:allow-version",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        "$HOME/.civitas/chats",
        "$HOME/.civitas/chats/*.json",
        "$HOME/.civitas/chats/*.json.*.tmp"
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": ["$HOME/.civitas/chats/*.json"]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        "$HOME/.civitas/data/**/*.aac",
        "$HOME/.civitas/data/**/*.flac",
        "$HOME/.civitas/data/**/*.gif",
        "$HOME/.civitas/data/**/*.jpeg",
        "$HOME/.civitas/data/**/*.jpg",
        "$HOME/.civitas/data/**/*.m4a",
        "$HOME/.civitas/data/**/*.mkv",
        "$HOME/.civitas/data/**/*.mov",
        "$HOME/.civitas/data/**/*.mp3",
        "$HOME/.civitas/data/**/*.mp4",
        "$HOME/.civitas/data/**/*.ogg",
        "$HOME/.civitas/data/**/*.png",
        "$HOME/.civitas/data/**/*.wav",
        "$HOME/.civitas/data/**/*.webm",
        "$HOME/.civitas/data/**/*.webp"
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        "$HOME/.civitas/chats/*.json",
        "$HOME/.civitas/chats/*.json.*.tmp",
        "$HOME/.civitas/pi-chat/large-context/**/*.txt"
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": ["$HOME/.civitas/chats"]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": ["$HOME/.civitas/chats/*.json"]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        "$HOME/.civitas/chats",
        "$HOME/.civitas/pi-chat/large-context",
        "$HOME/.civitas/pi-chat/large-context/**"
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        "$HOME/.civitas/chats/*.json",
        "$HOME/.civitas/chats/*.json.*.tmp"
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        "$HOME/.civitas/chats/*.json",
        "$HOME/.civitas/chats/*.json.*.tmp"
      ]
    }
  ]
}
