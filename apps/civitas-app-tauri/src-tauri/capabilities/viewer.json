{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "consumer-viewer",
  "description": "Read-only local state and window controls for the fixed viewer pool.",
  "local": true,
  "windows": [
    "viewer-01",
    "viewer-02",
    "viewer-03",
    "viewer-04",
    "viewer-05",
    "viewer-06",
    "viewer-07",
    "viewer-08"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:app:allow-version",
    "core:window:allow-theme",
    "core:window:allow-close",
    "core:window:allow-is-fullscreen",
    "core:path:allow-resolve-directory",
    "core:path:allow-join",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "deep-link:allow-get-current",
    "os:allow-platform",
    "os:allow-os-type",
    "os:allow-version"
  ]
}
