{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "consumer-onboarding",
  "description": "First-run notification, permission-flow, restart, and local-data reveal permissions.",
  "local": true,
  "windows": ["onboarding"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:app:allow-version",
    "core:resources:allow-close",
    "core:window:allow-theme",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:path:allow-resolve-directory",
    "core:path:allow-join",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "deep-link:allow-get-current",
    "os:allow-platform",
    "os:allow-os-type",
    "os:allow-version",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "permission-flow:allow-create",
    "permission-flow:allow-authorization-state",
    "permission-flow:allow-suggested-host-app-path",
    "permission-flow:allow-start-flow",
    "permission-flow:allow-stop-current-flow",
    "process:allow-restart",
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        { "path": "$HOME/.civitas" }
      ]
    }
  ]
}
